# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.
ANTHROPIC_API_KEY=

# Modelo por API (Anthropic)
SKILLDOC_API_MODEL=claude-haiku-5-5
# Valor por defecto del razonamiento previo para llamadas directas al proveedor.
# Las iteraciones de analyze.py lo fijan solas (V4, la final, usa adaptive).
SKILLDOC_API_THINKING=off
SKILLDOC_API_EFFORT=low
SKILLDOC_API_MAX_TOKENS=4000

# Modelo local (Ollama)
SKILLDOC_LOCAL_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
